# Frontend environment (public - these VITE_ values ship in the browser bundle).
# NEVER put secret keys (Groq etc.) here; secrets live in backend/.env only.

# Firebase (client config, safe to expose)
VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# URL of the Bazaar Brain backend (Express server)
VITE_API_URL=http://localhost:3001
