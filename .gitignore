# ── Logs ──────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Dependencies ───────────────────────────────────────────────────────────
node_modules
frontend/node_modules
backend/node_modules

# ── Build output ───────────────────────────────────────────────────────────
frontend/dist
frontend/dist-ssr
*.local

# ── Environment files (never commit real secrets) ──────────────────────────
.env
frontend/.env
backend/.env
# Production env files carry real secrets too - keep them local only
backend/.env.production
frontend/.env.production

# Firebase Admin service account keys (never commit)
service-account*.json
*firebase-adminsdk*.json

# ── Editor / OS ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
