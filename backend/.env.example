# Server
PORT=3001
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
# Include your Vercel frontend URL in production.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Groq (SERVER ONLY - never prefix with VITE_, never commit a real key).
# Rotate keys that were ever exposed in a browser bundle.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google OAuth (web application client) - primary sign-in method.
# The OAuth callback URL must be registered in Google Cloud Console
# (APIs & Services -> Credentials -> Authorized redirect URIs):
#   http://localhost:3001/api/auth/google/callback
#   https://<your-backend-host>/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Frontend origin the OAuth flow returns to (defaults to the first
# FRONTEND_ORIGIN entry). In production set this to your Vercel URL.
FRONTEND_URL=http://localhost:5173
# Secret used to sign the app's own HS256 session tokens (generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
SESSION_SECRET=generate_a_long_random_hex_string
SESSION_TTL_DAYS=30

# Firebase Admin (legacy token verification fallback; sign-in no longer uses
# Firebase. Provide a service account (JSON string or file path) or rely on
# Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS / gcloud auth).
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional signal sources (the agent degrades gracefully without them).
# Tavily web search: recent local news/social buzz for Lucknow.
# TAVILY_API_KEY=tvly-...
# Live mandi prices from Agmarknet via data.gov.in (without it, MOCK prices are used).
# DATA_GOV_IN_API_KEY=...

# Checkpointer: 'memory' (default, dev - non-persistent) or 'firestore'
# (prod - pending vendor approvals survive a server restart).
# Firestore mode needs the Firebase Admin credentials above.
CHECKPOINT_BACKEND=memory

# Optional WhatsApp Morning Delivery (T3.6): Cloud API OR Twilio.
# When omitted, messages run in safe dry-run/preview mode without external sends.
# WHATSAPP_CRON_ENABLED=true
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=bazaar-brain-verify
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional Observability & Reliability (T4.2 / T4.3)
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=bazaar-brain
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# SIGNAL_CACHE_TTL_MS=1800000
# LLM_TIMEOUT_MS=20000
# LLM_MAX_RETRIES=2
