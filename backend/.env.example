# Server
PORT=3001
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
# Include your Vercel frontend URL in production.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Groq (SERVER ONLY - never prefix with VITE_, never commit a real key).
# Rotate keys that were ever exposed in a browser bundle.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Firebase Admin (for verifying Firebase ID tokens).
# Option A (preferred): service account JSON file from
#   Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
#
# Option B: the JSON contents inline (mind the newlines in private_key).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Option C (verification-only): just the project id. ID tokens are still fully
# verified (signature + audience + expiry), but admin APIs that MINT tokens
# (custom tokens, session cookies) are unavailable.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional signal sources (the agent degrades gracefully without them).
# Tavily web search: recent local news/social buzz for Lucknow.
# TAVILY_API_KEY=tvly-...
# Live mandi prices from Agmarknet via data.gov.in (without it, MOCK prices are used).
# DATA_GOV_IN_API_KEY=...

# Checkpointer: 'memory' (default, dev - non-persistent) or 'firestore'
# (prod - pending vendor approvals survive a server restart).
# Firestore mode needs the Firebase Admin credentials above.
CHECKPOINT_BACKEND=memory

# Optional WhatsApp Morning Delivery (T3.6): Cloud API OR Twilio.
# When omitted, messages run in safe dry-run/preview mode without external sends.
# WHATSAPP_CRON_ENABLED=true
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=bazaar-brain-verify
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
