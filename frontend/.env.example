# Frontend environment (public - these VITE_ values ship in the browser bundle).
# NEVER put secret keys (Groq, Google client secret etc.) here; secrets live in backend/.env only.

# URL of the Bazaar Brain backend (Express server) that handles Google OAuth
# and issues session tokens. No client-side auth credentials are needed.
VITE_API_URL=http://localhost:3001

# Auth note: sign-in is Google OAuth handled by the backend
# (/api/auth/google/start -> Google -> /api/auth/google/callback ->
# frontend /auth/callback). The OAuth client id/secret and the session-signing
# secret are backend-only env vars.
